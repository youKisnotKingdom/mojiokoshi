# ============================================================
# Mojiokoshi 環境変数設定例
# このファイルを .env にコピーして値を編集してください
# cp .env.example .env
# ============================================================

# 【必須】秘密鍵 - 以下コマンドで生成してください:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 【必須】初回起動時に作成する管理者アカウント
# 一度作成されたら以降は削除して構いません
ADMIN_USER_ID=000001
ADMIN_PASSWORD=ChangeMe123

# PostgreSQL パスワード（デフォルト: mojiokoshi）
POSTGRES_PASSWORD=mojiokoshi

# アプリ公開ポート（HTTP、デフォルト: 8000）
APP_PORT=8000

# チェッカーデモアプリのポート（HTTP、デフォルト: 8001）
CHECKER_PORT=8001

# ============================================================
# 推奨本番プロファイル
# - batch engine: Parakeet JA
# - 通常運用: worker=1, chunk=300秒
# - 混雑時のみ `docker compose up -d --scale worker=2` を検討
# - realtime UI は当面 off
# - upload 上限はまず 1GB
# ============================================================

# 音声アップロード上限（bytes）
# 1GB = 1073741824 / 2GB = 2147483648
# Web 運用の初期値は 1GB を推奨
MAX_UPLOAD_SIZE=1073741824

# 結果画面に「次の操作」を表示するか（利用者向け画面では false 推奨）
SHOW_NEXT_ACTIONS=false

# nginx 側のアップロード上限
# `MAX_UPLOAD_SIZE` と揃えてください
# 1GB = 1g / 2GB = 2g
NGINX_CLIENT_MAX_BODY_SIZE=1g

# ============================================================
# 認証設定
# 既定はローカルユーザー認証です。OpenLDAPを使う場合だけ有効化してください。
# LDAPサーバーはこのDocker Composeでは起動しません。既存のLDAPサーバーを指定します。
# ============================================================

LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://ldap.example.local:389
LDAP_BIND_DN=cn=readonly,dc=example,dc=local
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=ou=people,dc=example,dc=local
LDAP_USER_FILTER=(uid={username})
LDAP_USER_ID_ATTRIBUTE=uid
LDAP_DISPLAY_NAME_ATTRIBUTE=cn
LDAP_START_TLS=false
LDAP_CONNECT_TIMEOUT=5
LDAP_DEFAULT_ROLE=user
LDAP_BOOTSTRAP_ADMIN_USER_IDS=
LOCAL_PASSWORD_LOGIN_ENABLED=true

# 任意: LDAPグループに所属するユーザーを管理者として扱う場合だけ設定
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=local
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_ADMIN_GROUP_DN=

# HTTPS ポート（docker-compose.https.yml 使用時、デフォルト: 443）
# 443 が使えない場合は 8443 などに変更
# HTTPS_PORT=8443

# チェッカーデモアプリの HTTPS ポート（デフォルト: 8444）
# マイク使用のため HTTPS が必要
# CHECKER_HTTPS_PORT=8444

# ============================================================
# LLM（後処理機能）設定
# llama.cpp / Ollama など OpenAI 互換 API のエンドポイントを指定
# ============================================================

# LLM API エンドポイント（例: 同一ネットワーク上の別ホスト）
LLM_API_BASE_URL=http://<llm-server-ip>:8080/v1

# LLM API キー（不要な場合は空欄のまま）
LLM_API_KEY=

# 使用するモデル名
LLM_MODEL_NAME=default

# 長い整形・議事録向けの出力上限
# 文字起こし整形はチャンク結果の結合を優先しますが、他プロンプトではこの上限を使います。
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=300

# 文字起こし完了時に自動実行する LLM 処理テンプレート名（カンマ区切り）
# 空にすると自動実行を無効化できます。
AUTO_LLM_PROMPT_TEMPLATE_NAMES=文字起こし整形

# ASRチャンクごとのLLM整形
# 別ホストLLMを使う場合、ASR完了前からチャンク単位で処理できます。
# URL/モデル名が空欄の場合は上の LLM_API_BASE_URL / LLM_MODEL_NAME を使います。
# API Key が空欄の場合、専用URL設定時は認証なし、専用URL未設定時は LLM_API_KEY を使います。
CHUNK_REFINEMENT_LLM_API_BASE_URL=
CHUNK_REFINEMENT_LLM_API_KEY=
CHUNK_REFINEMENT_LLM_MODEL_NAME=
CHUNK_REFINEMENT_LLM_TEMPERATURE=0.1
# 0 の場合は LLM_TIMEOUT を使います。
CHUNK_REFINEMENT_LLM_TIMEOUT=0
ENABLE_CHUNK_LLM_REFINEMENT=true
LLM_CHUNK_REFINEMENT_MAX_INPUT_CHARS=12000
LLM_CHUNK_REFINEMENT_MAX_OUTPUT_TOKENS=2000
LLM_CHUNK_REFINEMENT_CONTEXT_CHARS=1000

# LLM専用workerの並列数。GPUは使わず、別ホストLLM APIへ投げます。
LLM_WORKER_CHUNK_REFINEMENT_CONCURRENCY=2
LLM_WORKER_SUMMARY_CONCURRENCY=1

# 話者分離専用workerの並列数。通常起動では profile により無効です。
# 使う場合のみ `docker compose --profile diarization up -d diarization-worker` で起動します。
DIARIZATION_WORKER_CONCURRENCY=1
WORKER_SPEAKER_DIARIZATION_STALE_TIMEOUT_SECONDS=14400

# ============================================================
# Whisper（文字起こし）設定
# ============================================================

# モデルサイズ: tiny / base / small / medium / large
# GPU なし環境では small または medium を推奨（large は遅い）
WHISPER_MODEL_SIZE=large
DEFAULT_TRANSCRIPTION_ENGINE=reazon_nemo_v2
# 空欄の場合は WHISPER_DEVICE に合わせます。Cohere だけ CPU/GPU を変える場合のみ cpu/cuda/auto を指定します。
COHERE_TRANSCRIBE_DEVICE=
PARAKEET_CHUNK_SECONDS=300
PARAKEET_SAMPLE_RATE=16000
ENABLE_SPEAKER_DIARIZATION=false
SPEAKER_DIARIZATION_MODEL_ID=pyannote/speaker-diarization-community-1
# オフライン運用では、事前に取得した pyannote モデルをここへ mount してください
# 例: /app/models/pyannote/speaker-diarization-community-1
SPEAKER_DIARIZATION_MODEL_PATH=
# GPU がある本番機では cuda、CPU fallback を許す場合は auto
SPEAKER_DIARIZATION_DEVICE=auto
SPEAKER_DIARIZATION_MIN_SPEAKERS=0
SPEAKER_DIARIZATION_MAX_SPEAKERS=0
# 初回取得時だけ利用。runtime で MODEL_PATH を使うなら空で構いません。
HUGGINGFACE_TOKEN=

# web 側の使用デバイス: 通常は cpu のままにして batch と分離
WEB_WHISPER_DEVICE=cpu

# worker 側の使用デバイス: NVIDIA GPU がある場合は cuda を推奨
WORKER_WHISPER_DEVICE=cuda

# 音声ファイルの保持日数（この日数を超えたファイルは自動削除）
AUDIO_RETENTION_DAYS=30

# リアルタイム録音 UI を有効化するか（本番では false 推奨）
ENABLE_REALTIME_TRANSCRIPTION=false

# worker のポーリング間隔（秒）
WORKER_POLL_INTERVAL=5

# 期限切れ音声ファイルの削除チェック間隔（秒）。0 で停止。
WORKER_CLEANUP_INTERVAL_SECONDS=3600

# worker が同時に処理する文字起こしジョブ数
# model restore が重いので、通常は `1` を推奨
WORKER_TRANSCRIPTION_CONCURRENCY=1

# worker が同時に処理する LLM 処理ジョブ数
WORKER_SUMMARY_CONCURRENCY=1

# ASR worker 本体では話者分離を処理しない。diarization-worker に任せる。
WORKER_SPEAKER_DIARIZATION_CONCURRENCY=0

# PROCESSING のまま残った stale job を再キューするまでの秒数
# 実際の最大処理時間より十分長くしてください
WORKER_TRANSCRIPTION_STALE_TIMEOUT_SECONDS=3600
WORKER_SUMMARY_STALE_TIMEOUT_SECONDS=1800

# checker デモは GPU 競合を避けるため CPU を推奨
CHECKER_WHISPER_DEVICE=cpu
CHECKER_WHISPER_LANGUAGE=ja
